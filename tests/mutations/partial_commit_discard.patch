+++ b/app/services/uploads.py
@@ -507,7 +507,8 @@
             except ClientDisconnect:
                 if not keep_cut:
                     raise
-                cut = True
+                await to_thread.run_sync(_unlink_sync, path)
+                return Spooled(received=0, cut=True)
         finally:
             await to_thread.run_sync(f.close)
     except BaseException:
