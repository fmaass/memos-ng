# SYNTHETIC fixture — every address is example.test and every credential is a placeholder.
# It is the SHAPE of the retired satellite's .env, never a copy of it.
SMTP_HOST=smtp.example.test
SMTP_USER=digest@example.test
SMTP_PASSWORD=placeholder-not-a-password
SMTP_FROM_NAME=The Test Digest Mail
SMTP_FROM_EMAIL=Digest@Example.Test
DAILY_MAIL_RECIPIENTS=one@example.test, two@example.test ,ONE@example.test,not-an-address,three@example.test
IMAGE_GRACE_MINUTES=45
MAX_EMAIL_SIZE_BYTES=20971520
MAIL_EPOCH=2026-06-01
MEMOS_VISIBILITY_FILTER=PUBLIC,PROTECTED
DROPBOX_FOLDER=/test-mail
DROPBOX_RETENTION_DAYS=14
LINK_IMAGES_TO_DROPBOX=true
DROPBOX_REFRESH_TOKEN=placeholder-not-a-refresh-token
