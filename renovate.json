{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "labels": ["dependencies"],
  "lockFileMaintenance": { "enabled": true },
  "packageRules": [
    {
      "description": "Group non-major npm + Python updates into one PR to cut noise",
      "matchManagers": ["npm", "pep621"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "non-major dependencies"
    },
    {
      "description": "GitHub Actions pinned digests, grouped",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    }
  ]
}
