    "blurhash": "^2.0.5",
    "dompurify": "^3.4.11",
    "maplibre-gl": "^6.10.0",
    "markdown-it": "^14.2.0",
    "markdown-it-task-lists": "^2.1.1",
    "openapi-fetch": "^0.13.4",
    "photoswipe": "^5.4.4",
    "pmtiles": "^4.5.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "tailwindcss": "^4.2.4",
    "tailwindcss-primeui": "^0.6.1",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4"
