<!DOCTYPE html>
<html lang="{{ language }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<title>{{ subject }}</title>
<style>
  @media only screen and (max-width:600px){
    .container{ width:100% !important; }
    .px{ padding-left:18px !important; padding-right:18px !important; }
    .h1{ font-size:22px !important; }
  }
  @media (prefers-color-scheme: dark){
    .page{ background:#16181c !important; }
    .container{ background:#1f2329 !important; }
    .text{ color:#e6e8eb !important; }
    .muted{ color:#9aa3ad !important; }
    .dayhead{ background:#2a2f37 !important; color:#e6e8eb !important; }
    .footer{ background:#1a1d22 !important; color:#9aa3ad !important; }
  }
</style>
</head>
<body class="page" style="margin:0;padding:0;background:#f4f4f5;-webkit-text-size-adjust:100%;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" bgcolor="#f4f4f5" class="page" style="background:#f4f4f5;">
<tr><td align="center" style="padding:24px 12px;">

<table role="presentation" width="600" cellspacing="0" cellpadding="0" border="0" class="container" style="width:600px;max-width:600px;background:#ffffff;border-radius:14px;overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,0.06);">

  <tr><td style="background:#1f3a44;padding:26px 30px;text-align:center;">
    <div class="h1" style="color:#ffffff;font-size:25px;font-weight:700;letter-spacing:0.2px;">{{ mail_title }}</div>
    <div style="color:#a9c4cc;font-size:14px;margin-top:5px;">{{ date_range }}</div>
  </td></tr>

  <tr><td class="px" style="padding:22px 30px 0 30px;">
    <span class="dayhead" style="display:inline-block;background:#fbeae3;color:#c2562f;font-size:14px;font-weight:600;padding:6px 14px;border-radius:999px;">{{ day_label }}</span>
  </td></tr>

  {% if preview_cid %}
  <tr><td class="px" style="padding:16px 30px 0 30px;">
    <img src="cid:{{ preview_cid }}" alt="" width="{{ preview_width }}"{% if preview_height %} height="{{ preview_height }}"{% endif %} style="display:block;width:100%;max-width:{{ preview_width }}px;height:auto;border-radius:10px;border:0;">
  </td></tr>
  {% endif %}

  {% if first_html %}
  <tr><td class="px" style="padding:16px 30px 0 30px;">
    <div class="text" style="color:#33373d;font-size:16px;line-height:1.6;">{{ first_html | safe }}</div>
  </td></tr>
  {% endif %}

  <tr><td class="px" style="padding:14px 30px 0 30px;">
    <div class="muted" style="color:#6b737c;font-size:14px;line-height:1.5;">{{ counts }}</div>
    {% if older %}
    <div class="muted" style="color:#6b737c;font-size:14px;line-height:1.5;">{{ older }}</div>
    {% endif %}
  </td></tr>

  <tr><td class="px" align="center" style="padding:24px 30px 8px 30px;">
    <a href="{{ url }}" style="display:inline-block;background:#1f3a44;color:#ffffff;font-size:16px;font-weight:600;text-decoration:none;padding:12px 26px;border-radius:999px;">{{ t("link.open") }}</a>
  </td></tr>

  <tr><td class="px" align="center" style="padding:6px 30px 22px 30px;">
    <div class="muted" style="color:#6b737c;font-size:13px;line-height:1.5;word-break:break-all;">{{ url }}</div>
    <div class="muted" style="color:#6b737c;font-size:13px;line-height:1.5;margin-top:4px;">{{ online_until }}</div>
  </td></tr>

  <tr><td class="footer" style="background:#f7f8f9;padding:18px 30px;text-align:center;color:#8a929b;font-size:13px;">
    {{ mail_title }}
  </td></tr>

</table>
</td></tr>
</table>
</body>
</html>
